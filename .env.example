# Estoque Fácil — exemplo de variáveis de ambiente
# Copie este arquivo para .env e preencha com os valores reais.
# Nunca faça commit do .env real.

# URL do projeto Supabase (público, aparece no cliente)
SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública do Supabase (publishable/anon)
SUPABASE_KEY=sua-chave-publica-aqui

# E-mail do administrador (usado para autorização client-side)
ADMIN_EMAIL=admin@exemplo.com

# Modo de desenvolvimento (opcional)
# NODE_ENV=development
